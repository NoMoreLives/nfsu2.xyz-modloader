{
  "manifest_version": 3,
  "name": "U2 Mod Loader",
  "version": "0.5.0",
  "description": "Loads client-side mods into the browser version of NFS Underground 2.",
  "content_scripts": [
    {
      "matches": ["https://nfsu2.xyz/*", "https://*.nfsu2.xyz/*", "http://localhost/*"],
      "js": ["lib/wasmpatch.js", "loader.js", "mods/topdown.js", "mods/drone.js", "mods/camfinder.js", "mods/hookprobe.js", "mods/rev.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
